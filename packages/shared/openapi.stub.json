  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "guards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "fix_href": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Stat": {
        "type": "object",
        "required": [
          "key",
          "label",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "delta": {
            "type": "string",
            "description": "Change vs previous period, e.g. +12%"
          },
          "delta_good": {
            "type": "boolean",
            "description": "Whether the change is good news"
          },
          "trend": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Sparkline values, oldest first"
          }
        }
      },
      "Row": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "ProjectSummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "channel",
          "format",
          "state",
          "states",
          "guards"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "guards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PageData": {
        "type": "object",
        "required": [
          "stats",
          "rows",
          "next_cursor"
        ],
        "properties": {
          "stats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stat"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Row"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "$ref": "#/components/schemas/ProjectSummary"
          }
        }
      },
      "Overview": {
        "type": "object",
        "required": [
          "kpis",
          "pipeline",
          "approvals",
          "alerts",
          "schedule",
          "activity",
          "views_14d"
        ],
        "properties": {
          "kpis": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stat"
            }
          },
          "pipeline": {
            "type": "array",
            "items": {
