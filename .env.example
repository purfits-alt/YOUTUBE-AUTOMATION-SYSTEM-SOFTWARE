# TubeForge environment variables (copy to .env for local development only).
# NON-SECRET configuration only. Never put API keys or tokens here — they are stored
# encrypted inside TubeForge (Phase 3+). The database password belongs in the libpq
# password file (pgpass), not in this file.

TUBEFORGE_ENV=dev
# TUBEFORGE_HOME=D:\YOUTUBE AUTOMATION SYSTEM SOFTWARE
# TUBEFORGE_CONFIG=D:\YOUTUBE AUTOMATION SYSTEM SOFTWARE\config\tubeforge.toml
TUBEFORGE_PORT=8765
TUBEFORGE_DATABASE_URL=postgresql+psycopg://tubeforge@127.0.0.1:5432/tubeforge
TUBEFORGE_LOG_LEVEL=INFO

# Tests only: a throwaway database that the integration tests may wipe.
# TUBEFORGE_TEST_DATABASE_URL=postgresql+psycopg://tubeforge@127.0.0.1:5432/tubeforge_test
