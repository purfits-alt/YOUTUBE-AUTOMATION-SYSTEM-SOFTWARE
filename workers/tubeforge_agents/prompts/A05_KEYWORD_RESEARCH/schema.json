{
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["phrase", "intent", "rationale", "evidence", "confidence"],
        "properties": {
          "phrase": { "type": "string", "minLength": 2, "maxLength": 80 },
          "intent": { "enum": ["LEARN", "COMPARE", "HOW_TO", "NEWS", "ENTERTAIN"] },
          "rationale": { "type": "string", "maxLength": 200 },
          "evidence": {
            "type": "array", "maxItems": 3,
            "items": {
              "type": "object", "required": ["source_document_id", "quote"],
              "properties": {
                "source_document_id": { "type": "string", "maxLength": 64 },
                "quote": { "type": "string", "maxLength": 300 }
              }
            }
          },
          "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] }
        }
      }
    }
  }
}
