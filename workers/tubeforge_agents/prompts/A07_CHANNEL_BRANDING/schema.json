{
  "type": "object",
  "required": ["name_ideas", "description", "tone", "palette", "fonts", "logo_brief", "banner_brief"],
  "additionalProperties": false,
  "properties": {
    "name_ideas": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": { "type": "object", "required": ["name", "reason"],
        "properties": { "name": { "type": "string", "minLength": 2, "maxLength": 40 }, "reason": { "type": "string", "maxLength": 150 },
          "availability_note": { "type": "string", "maxLength": 200 } } }
    },
    "description": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "tone": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "maxLength": 30 } },
    "palette": {
      "type": "array", "minItems": 4, "maxItems": 6,
      "items": { "type": "object", "required": ["hex", "role"],
        "properties": { "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "role": { "type": "string", "maxLength": 40 } } }
    },
    "fonts": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "type": "object", "required": ["family", "use"],
        "properties": { "family": { "type": "string", "maxLength": 40 }, "use": { "enum": ["HEADLINE", "BODY"] } } }
    },
    "logo_brief": { "type": "string", "maxLength": 600 },
    "banner_brief": { "type": "string", "maxLength": 600 }
  }
}
