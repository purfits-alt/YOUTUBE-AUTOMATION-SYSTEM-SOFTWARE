{
  "type": "object",
  "required": ["scenes"],
  "additionalProperties": false,
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "required": ["first", "last", "visual_instruction", "style"],
        "additionalProperties": false,
        "properties": {
          "first": {"type": "string", "pattern": "^s[0-9]{1,4}$"},
          "last": {"type": "string", "pattern": "^s[0-9]{1,4}$"},
          "visual_instruction": {"type": "string", "minLength": 1, "maxLength": 1000},
          "on_screen_text": {"type": ["string", "null"], "maxLength": 120},
          "style": {"enum": ["kinetic_text", "motion_graphics", "chart", "photo", "owner_footage", "screen_recording"]},
          "pattern_interrupt": {"type": "boolean"}
        }
      }
    }
  }
}
