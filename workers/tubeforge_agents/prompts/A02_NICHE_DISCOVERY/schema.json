{
  "type": "object",
  "required": ["candidates"],
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["name", "summary", "language", "criteria", "inauthentic_risk", "production_difficulty"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 80 },
          "summary": { "type": "string", "minLength": 10, "maxLength": 600 },
          "language": { "enum": ["en", "es", "fr", "de", "ur"] },
          "criteria": {
            "type": "array", "minItems": 1, "maxItems": 11,
            "items": {
              "type": "object",
              "required": ["code", "value", "evidence", "confidence"],
              "properties": {
                "code": { "type": "string", "maxLength": 40 },
                "value": { "type": "integer", "minimum": 0, "maximum": 100 },
                "evidence": {
                  "type": "array", "maxItems": 5,
                  "items": {
                    "type": "object", "required": ["source_document_id", "quote"],
                    "properties": {
                      "source_document_id": { "type": "string", "maxLength": 64 },
                      "quote": { "type": "string", "maxLength": 300 }
                    }
                  }
                },
                "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
                "note": { "type": "string", "maxLength": 200 }
              }
            }
          },
          "inauthentic_risk": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "production_difficulty": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "originality_angles": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } }
        }
      }
    }
  }
}
