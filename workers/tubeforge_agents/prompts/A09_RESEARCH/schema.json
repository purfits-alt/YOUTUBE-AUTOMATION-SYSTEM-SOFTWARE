{
  "type": "object",
  "required": ["summary", "key_points", "claims", "open_questions", "suggested_structure", "hook_ideas"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "key_points": { "type": "array", "minItems": 3, "maxItems": 12, "items": { "type": "string", "maxLength": 300 } },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "text", "source_document_ids", "quote"],
        "properties": {
          "id": { "type": "string", "maxLength": 10 },
          "text": { "type": "string", "minLength": 5, "maxLength": 400 },
          "source_document_ids": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "maxLength": 64 } },
          "quote": { "type": "string", "maxLength": 300 },
          "as_of": { "type": ["string", "null"], "maxLength": 10 }
        }
      }
    },
    "open_questions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } },
    "suggested_structure": {
      "type": "array", "maxItems": 10,
      "items": { "type": "object", "required": ["section", "purpose"], "properties": { "section": { "type": "string", "maxLength": 80 }, "purpose": { "type": "string", "maxLength": 200 } } }
    },
    "hook_ideas": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } }
  }
}
